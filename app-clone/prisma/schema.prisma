generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Better Auth ----------
model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------- App ----------
model Workspace {
  id          String   @id @default(cuid())
  name        String
  plan        String   @default("trial")
  healthScore Int?
  healthDelta Int?
  // Workspace-scoped settings: { companyName, location, confidenceThreshold,
  // analysisFocus, dataRetentionMonths } — written from Settings.
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
  invites     Invite[]
  connections Connection[]
  deals       CrmDeal[]
  contacts    CrmContact[]
  accounts    CrmAccount[]
  captures    Capture[]
  proposals   Proposal[]
  audits      AuditEvent[]
  signatures  SignatureRequest[]
  snapshots   HealthSnapshot[]
  guardrails  GuardrailSetting?
  assistantMessages AssistantMessage[]

  @@map("workspace")
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("member")
  // Optional display override for the shell's role line (the demo persona
  // stores "RevOps Admin"); null → the label is derived from `role`.
  roleLabel   String?
  // The member's self-described job (picked on the sign-up role step:
  // Owner / Admin / Manager / Sales Rep / Viewer). Purely descriptive —
  // the permission role is `role` (a workspace creator is always "owner").
  jobRole     String?
  // Per-user preferences inside this workspace (Settings → Notifications):
  // { emailNotifications, slackNotifications, approvalReminders, syncAlerts, frequency }
  settings    Json?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("membership")
}

// A pending team invitation. The invitee accepts via /invite/<token> after
// signing in with the invited email; accepting creates the Membership with
// the invited role. A pending invite reserves a seat (per-seat pricing).
model Invite {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        String // owner | admin | manager | rep | viewer (owner is never invitable)
  token       String   @unique
  status      String   @default("pending") // pending | accepted | revoked
  expiresAt   DateTime
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("invite")
}

model Connection {
  id            String    @id @default(cuid())
  workspaceId   String
  provider      String // hubspot | salesforce | google | outlook | signudoc
  accountEmail  String?
  data          String // AES-256-GCM encrypted JSON
  settings      Json? // per-app preferences: { apps: { [appId]: { permissions, syncFrequency } }, reconnectedAt }
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("connection")
}

model CrmDeal {
  id            String    @id @default(cuid())
  workspaceId   String
  externalId    String
  source        String    @default("local") // hubspot | salesforce | local
  name          String
  company       String?
  stage         String // display label
  amount        Float?
  currency      String    @default("USD")
  ownerName     String?
  closeDate     DateTime?
  lastActivityAt DateTime @default(now())
  healthFlag    String? // going_cold | no_reply | promise_due
  healthNote    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, externalId])
  @@map("crm_deal")
}

// An account (company) created explicitly from Deals & Contacts. Most
// accounts are DERIVED from the company strings on deals/contacts; this
// model only holds companies created by hand before they have records,
// plus an industry override for any company.
model CrmAccount {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  industry    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@map("crm_account")
}

model CrmContact {
  id          String    @id @default(cuid())
  workspaceId String
  externalId  String?
  name        String
  email       String?
  company     String?
  title       String?
  industry    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("crm_contact")
}

model Capture {
  id          String    @id @default(cuid())
  workspaceId String
  kind        String // email | meeting | call | chat
  source      String // gmail | calendar | outlook | zoom | manual
  externalId  String?
  title       String
  fromLabel   String?
  body        String    @default("")
  snippet     String    @default("")
  occurredAt  DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  proposals   Proposal[]

  @@unique([workspaceId, externalId])
  @@map("capture")
}

model Proposal {
  id             String    @id @default(cuid())
  workspaceId    String
  type           String // deal_stage | deal_field | new_contact | new_deal | followup_draft | task | hygiene_fix
  category       String    @default("deal_update") // deal_update | new_contact | enrichment | followup | field_fix
  title          String
  detail         Json      @default("{}")
  reason         String    @default("")
  source         String    @default("engine") // gmail | calendar | call | chat | hygiene | signudoc | engine
  confidence     Int?
  captureId      String?
  dealExternalId String?
  status         String    @default("pending") // pending | approved | rejected | applied | undone | failed
  // Apply batch this proposal was written to the CRM in (History screen).
  // One batch per approve action; a bulk approve shares one id. Null for
  // proposals that were never part of an apply (pending/rejected).
  batchId        String?
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?
  appliedAt      DateTime?
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  capture        Capture?  @relation(fields: [captureId], references: [id], onDelete: SetNull)

  @@map("proposal")
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  action      String // proposed | approved | rejected | applied | undone | failed | connected | disconnected | captured | synced
  summary     String
  meta        Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("audit_event")
}

model SignatureRequest {
  id             String    @id @default(cuid())
  workspaceId    String
  dealExternalId String
  title          String
  signerName     String
  signerEmail    String
  envelopeId     String?
  status         String    @default("requested") // requested | sent | completed | declined
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("signature_request")
}

// One row per workspace per day, written whenever a health scan runs (the
// engine's run path). Powers the Data Cleanup "Data Quality Trend" — every
// point is a real scan's counts, never a drawn curve.
model HealthSnapshot {
  id            String    @id @default(cuid())
  workspaceId   String
  date          DateTime // start of day (local)
  score         Int
  dupCount      Int
  missingCount  Int
  unloggedCount Int
  staleCount    Int
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
  @@map("health_snapshot")
}

// Data Guardrails (Data Cleanup): per-workspace prevention rules. A missing
// row means the defaults — everything on. lastDupCount freezes the duplicate
// count at the moment detection was switched off, so dashboards keep showing
// the last computed figure instead of a fake zero.
model GuardrailSetting {
  id                  String    @id @default(cuid())
  workspaceId         String    @unique
  enabled             Boolean   @default(true) // master switch
  autoEnrich          Boolean   @default(true)
  preventInvalidStage Boolean   @default(true)
  requireNextStep     Boolean   @default(true)
  detectDuplicates    Boolean   @default(true)
  flagSuspicious      Boolean   @default(true)
  lastDupCount        Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("guardrail_setting")
}

// In-product AI Assistant chat. One thread per conversation ("New chat"
// starts a new threadId; the page shows the latest thread). Assistant
// messages that prepared a change link to the Proposal they created —
// the proposal still goes through the normal approval flow; the chat
// card is just another window onto it. `meta` carries the structured
// blocks (deal rows, links) so history re-renders exactly as sent.
model AssistantMessage {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  threadId    String
  role        String // user | assistant
  content     String
  meta        Json?
  proposalId  String?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, threadId, createdAt])
  @@map("assistant_message")
}
